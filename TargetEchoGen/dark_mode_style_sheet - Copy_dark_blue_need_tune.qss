/* =========================================================================
   RADAR UI THEME (Qt Style Sheet / QSS)
   Compatible with Qt5/Qt6 — No unsupported properties
   =========================================================================
   Palette:
     - Base background: deep navy/black with subtle teal gradient
     - Primary accent (radar green): #27D07D
     - Secondary accent (teal/cyan):  #18A0B6
     - Borders / focus:               #33E1A0
     - Selection / active:            #27D07D
     - Text:                          #FFFFFF
   ========================================================================= */

/*----- QWidget (app-wide background) -------------------------------------*/
QWidget {
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1,
        stop:0   rgba(3, 10, 20, 255),
        stop:0.35 rgba(10, 35, 55, 255),
        stop:0.7  rgba(8, 28, 48, 255),
        stop:1    rgba(2, 6, 12, 255));
    color: #FFFFFF;
    font-family: "Segoe UI", "Arial";
    font-size: 12px;
}

/*----- QLabel -------------------------------------------------------------*/
QLabel {
    background-color: transparent;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 14px;
}

/* Specific LED/status labels */
#LblConnPL10GStatusLed,
#LblConnPL1GStatusLed,
#LblConnPS1GStatusLed,
#LblConnPSSerialStatusLed,
#LblConnPLSerialStatusLed,
#LblDevMemStatusLedSSD1,
#LblDevMemStatusLedSSD2,
#LblDevLedLMKLock,
#LblDevLedLMXLock {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    background: transparent;
    border: none;
}

/*----- QPushButton --------------------------------------------------------*/
QPushButton {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0   rgba(24, 82, 92, 255),
        stop:1   rgba(9, 45, 55, 255));
    color: #FFFFFF;
    border: 1px solid #18A0B6;
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 600;
    font-size: 14px;
    min-height: 25px;
    max-height: 25px;
}

QPushButton:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0   rgba(35, 112, 125, 255),
        stop:1   rgba(14, 65, 78, 255));
    border: 1px solid #33E1A0;
}

QPushButton:pressed {
    background-color: #0B1C24;
    border: 1px solid #27D07D;
}

QPushButton:disabled {
    background: #0E232B;
    color: rgba(255,255,255,0.45);
    border: 1px solid rgba(24,160,182,0.35);
}

#PbRegWrite1,
#PbRegWrite2,
#PbRegWrite3,
#PbRegWrite4 {
    min-width: 145px;
}

/*----- Focus highlight (Qt-safe) -----------------------------------------*/
/* Limit thick focus ring to interactive widgets (avoid QGroupBox) */
QPushButton:focus,
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QCheckBox:focus,
QRadioButton:focus,
QTableWidget:focus {
    outline: none;
    border: 2px solid #33E1A0;
}

/*----- QProgressBar -------------------------------------------------------*/
QProgressBar {
    min-height: 20px;
    max-height: 20px;
    border: 1px solid #18A0B6;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    background-color: #081820;
    border-radius: 4px;
}

QProgressBar::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0   rgba(39, 208, 125, 255),
        stop:1   rgba(20, 140, 92, 255));
    margin: 1px;
    border-radius: 3px;
}

/*----- QGroupBox ----------------------------------------------------------*/
QGroupBox {
    border: 1px solid #18A0B6;
    border-radius: 6px;
    margin-top: 1.2em;              /* lets title overlap the top border */
    padding: 14px 8px 8px 8px;       /* space for contents */
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1,
        stop:0   rgba(5, 18, 28, 220),
        stop:0.5 rgba(6, 28, 40, 235),
        stop:1   rgba(4, 12, 18, 220));
    color: #FFFFFF;
    font: 700 12pt "Segoe UI";
}

/* Title is vertically centered over the border, with bg masking the line */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0px 8px;               /* thin vertical padding centers over line */
    color: #FFFFFF;
    background-color: palette(window); /* masks the border behind the text */
    font: 700 12pt "Segoe UI";
}

/* Keep QGroupBox from getting the thick focus border */
QGroupBox:focus {
    border: 1px solid #18A0B6;
}

/*----- QLineEdit ----------------------------------------------------------*/
QLineEdit {
    background-color: #0B2C3A;
    border: 1px solid #18A0B6;
    border-radius: 4px;
    padding: 4px 6px;
    color: #FFFFFF;
    font-weight: 600;
    min-height: 25px;
    max-height: 25px;
}

QLineEdit:disabled {
    background-color: #0E232B;
    color: rgba(255,255,255,0.5);
    border-color: rgba(24,160,182,0.35);
}

/*----- QComboBox ----------------------------------------------------------*/
QComboBox {
    background-color: #0B2C3A;
    border: 1px solid #18A0B6;
    border-radius: 4px;
    padding-left: 6px;
    color: #E6F8F1;
    font-weight: 600;
    min-height: 30px;
}

QComboBox:hover {
    background-color: #0E3646;
    border-color: #33E1A0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border-left: 1px solid #18A0B6;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    min-width
