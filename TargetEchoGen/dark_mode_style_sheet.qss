/*-----QWidget-----*/
QWidget {
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1,
        stop:0 rgba(3, 1, 50, 32),
        stop:0.3 rgba(6, 82, 125, 255),
        stop:0.5 rgba(8, 117, 178, 255),
        stop:0.75 rgba(7, 100, 164, 255),
        stop:1 rgba(3, 1, 50, 10));
    color: #ffffff;
    font-family: "Segoe UI", "Arial";
}

/*--------------------------QLabel------------------------------------------------------*/
QLabel {
    background-color: transparent;
    color: white;
    font-weight: bold;
    font-size: 14px;
}

/* 🔹 Specific labels: connection status and device LEDs */
#LblConnPL10GStatusLed,
#LblConnPL1GStatusLed,
#LblConnPS1GStatusLed,
#LblConnPSSerialStatusLed,
#LblConnPLSerialStatusLed,
#LblDevMemStatusLedSSD1,
#LblDevMemStatusLedSSD2,
#LblDevLedLMKLock,
#LblDevLedLMXLock {
    min-width: 30px;      /* 🔸 set minimum width */
    max-width: 30px;      /* 🔸 set maximum width */
    min-height: 30px;     /* 🔸 set minimum height */
    max-height: 30px;     /* 🔸 set maximum height */
    background: transparent;  /* optional, keep LED icons visible */
    border: none;             /* remove border */
}

/*--------------------------QLabel------------------------------------------------------*/

/*-----QPushButton-----*/
QPushButton {
    background-color: qlineargradient(spread:pad, x1:1, y1:0, x2:1, y2:1,
        stop:0 rgba(42, 95, 113, 255),
        stop:1 rgba(12, 53, 97, 255));
    color: #ffffff;
    border: 1px solid #1E90FF;
    border-radius: 4px;
    padding: 6px;
    font-weight: bold;
    font-size: 14px;
    min-height: 25px;
}

QPushButton:hover {
    background-color: #0056B3;
    border: 1px solid #ffffff;
}

QPushButton:pressed {
    background-color: #000000;
    color: #ffffff;
    border-style: inset;
}

/*-----QProgressBar-----*/
QProgressBar {
    min-height: 20px;
    max-height: 20px;
    border: 1px solid #ffffff;
    color: white;
    font-size: 12px;
    font-weight: bold;
    text-align: center;
    background-color: #000000;
}

QProgressBar::chunk {
    background-color: #0056B3;
    margin: 1px;
}
QGroupBox {
    border: 1px solid #1E90FF;
    border-radius: 5px;
    margin-top: 0.5em; /* Enough space for title */
    padding-top: 5px;
	background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1,
	stop:0 rgba(3, 1, 50, 32),
	stop:0.3 rgba(6, 82, 125, 255),
	stop:0.5 rgba(8, 117, 178, 255),
	stop:0.75 rgba(7, 100, 164, 255),
	stop:1 rgba(3, 1, 50, 10));
    color: white;
    font-size: 14px;
	font: 700 12pt "Segoe UI";
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 0px;
    /*background-color: qlineargradient(
        spread:pad, x1:0, y1:0, x2:0, y2:0,
        stop:0 rgba(58, 90, 105, 255),
        stop:1 rgba(42, 75, 95, 255)
    );*/
    color: white;
    font-size: 14px;
    font: 700 12pt "Segoe UI";
}

/*-----QLineEdit-----*/
QLineEdit {
    background-color: #0b2c4d;   /* flat dark blue background */
    border: 1px solid #1E90FF;
    border-radius: 4px;
    padding-left: 6px;
    color: white;
    font-weight: bold;
    min-height: 30px;
}

/*-----QComboBox-----*/
QComboBox {
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1,
        stop:0 rgba(3, 1, 50, 32),
        stop:0.3 rgba(6, 82, 125, 255),
        stop:0.5 rgba(8, 117, 178, 255),
        stop:0.75 rgba(7, 100, 164, 255),
        stop:1 rgba(3, 1, 50, 10));
    border: 1px solid #1E90FF;;
    border-radius: 3px;
    padding-left: 6px;
    color: lightgray;
    font-weight: bold;
    min-height: 30px;
}

QComboBox:hover {
    background-color: #008b8b;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border-left: 1px solid darkgray;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    min-width: 30px;
}

QComboBox::down-arrow {
    image: url(:/images/icons8-dropdown-26.png);
    width: 20px;
    height: 8px;
}

/*=======================================QSpinBox=======================================*/
/*----- QSpinBox (flat version) -----*/
QSpinBox {
    background-color: #0b2c4d;   /* flat dark blue background */
    border: 1px solid #1E90FF;
    border-radius: 4px;
    padding-left: 0px;
    color: white;
    font-weight: bold;
    min-height: 30px;
}
/*====================================================================================*/
QCheckBox {
    color: white;
    font-weight: bold;
    background: transparent;   /* fully transparent background */
    min-height: 25px;
    max-height: 25px;
    spacing: 4px;              /* space between indicator and text */
}

/* Size and appearance of the indicator box */
QCheckBox::indicator {
    width: 25px;       /* ⬅️ increase width */
    height: 25px;      /* ⬅️ increase height */
}

/* Optional: Custom style for unchecked state */
QCheckBox::indicator:unchecked {
    border-radius: 2px;
}

/* Optional: Checked state */
QCheckBox::indicator:checked {
    border-radius: 2px;
}

QCheckBox::indicator:checked {
    image: url(:/images/white-checked-checkbox-52.png);
}
QCheckBox::indicator:unchecked {
    image: url(:/images/white-un-checkbox-50.png);
}

/*-----QScrollBar-----*/
QScrollBar:vertical {
    border: none;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: qlineargradient(spread:pad, x1:1, y1:0, x2:1, y2:1,
        stop:0 rgba(167, 214, 50, 255),
        stop:1 rgba(98, 169, 67, 255));
    min-height: 50px;
    width: 16px;
}
/*==================================================================*/
/*-----QRadioButton-----*/
QRadioButton {
    color: white;
    background: transparent;
    min-height: 30px;
    font: 700 9pt "Segoe UI";
}

/* 🔹 Specific radio buttons: RbPL10GSel, RbPL1GSel, RbPS1GSel, RbPSSerialSel, RbPLSerialSel */
#RbPL10GSel,
#RbPL1GSel,
#RbPS1GSel,
#RbPSSerialSel,
#RbPLSerialSel {
    font-size: 15px;       /* ⬅️ change text size here */
    font-weight: bold;     /* optional */
    color: white;          /* text color */
}
/* 🔹 Specific radio buttons: RbPL10GSel, RbPL1GSel, RbPS1GSel, RbPSSerialSel, RbPLSerialSel */
#RbPL10GSel::indicator,
#RbPL1GSel::indicator,
#RbPS1GSel::indicator,
#RbPSSerialSel::indicator,
#RbPLSerialSel::indicator {
    width: 30px;        /* custom width */
    height: 30px;       /* custom height */
}

#RbPL10GSel::indicator:unchecked,
#RbPL1GSel::indicator:unchecked,
#RbPS1GSel::indicator:unchecked,
#RbPSSerialSel::indicator:unchecked,
#RbPLSerialSel::indicator:unchecked {
    background: transparent;
}

/* Checked state */
#RbPL10GSel::indicator:checked,
#RbPL1GSel::indicator:checked,
#RbPS1GSel::indicator:checked,
#RbPSSerialSel::indicator:checked,
#RbPLSerialSel::indicator:checked {
    /*border: 2px solid #f8f8ff;*/
    /*border-radius: 14px;*/
    background: transparent;
}

QRadioButton::indicator {
    width: 25px;
    height: 25px;
}

/* When unchecked */
QRadioButton::indicator:unchecked {
    image: url(:/images/white-radio-button-48.png);
}

/* When checked */
QRadioButton::indicator:checked {
    image: url(:/images/white-select-radio-button-48.png);
}
/*=======================================================================================*/

/*-----QTableWidget-----*/
QTableWidget::item {
    color: white;
    font-weight: bold;
}

QTableWidget::item:selected {
    background-color: green;
    color: white;
}

/*-----QTabWidget-----*/
QTabWidget::pane {
    border: 1px solid #1E90FF;;
    top: -1px;
}

QTabBar::tab {
    background-color: qlineargradient(spread:pad, x1:1, y1:0, x2:1, y2:1,
        stop:0 rgba(42, 95, 113, 255),
        stop:1 rgba(12, 53, 97, 255));
    color: #ffffff;
    border: 1px solid #1E90FF;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px;
    font-weight: bold;
    font-size: 14px;
    min-width: 80px;
    min-height: 20px;
}

QTabBar::tab:selected {
    background-color: #0D1A4F;
    border-bottom-color: #000000;
}

QTabBar::tab:hover {
    /*background-color: #008b8b;*/
	background-color: #0056B3;
    border: 1px solid #ffffff;
}
