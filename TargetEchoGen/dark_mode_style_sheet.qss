/* =========================================================================
   RADAR UI THEME (Qt Style Sheet / QSS)
   Compatible with Qt5/Qt6 — No unsupported properties
   =========================================================================
   Palette:
     - Base background: deep navy/black with subtle teal gradient
     - Primary accent (radar green): #27D07D
     - Secondary accent (teal/cyan):  #18A0B6
     - Borders / focus:               #33E1A0
     - Selection / active:            #27D07D
     - Text:                          #FFFFFF
   ========================================================================= */

/*----- QWidget (app-wide background) -------------------------------------*/
QWidget {
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1,
        stop:0   rgba(3, 10, 20, 255),
        stop:0.35 rgba(10, 35, 55, 255),
        stop:0.7  rgba(8, 28, 48, 255),
        stop:1    rgba(2, 6, 12, 255));
    color: #FFFFFF;
    font-family: "Segoe UI", "Arial";
    font-size: 12px;
}

/*----- QLabel -------------------------------------------------------------*/
QLabel {
    background-color: transparent;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 14px;
}

/* Specific LED/status labels */
#LblConnPL10GStatusLed,
#LblConnPL1GStatusLed,
#LblConnPS1GStatusLed,
#LblConnPSSerialStatusLed,
#LblConnPLSerialStatusLed,
#LblDevMemStatusLedSSD1,
#LblDevMemStatusLedSSD2,
#LblDevLedLMKLock,
#LblDevLedLMXLock {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    background: transparent;
    border: none;
}

/*----- QPushButton --------------------------------------------------------*/
QPushButton {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0   rgba(24, 82, 92, 255),
        stop:1   rgba(9, 45, 55, 255));
    color: #FFFFFF;
    border: 1px solid #18A0B6;
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 600;
    font-size: 14px;
    min-height: 26px;
    max-height: 26px;
}

QPushButton:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0   rgba(35, 112, 125, 255),
        stop:1   rgba(14, 65, 78, 255));
    border: 1px solid #33E1A0;
}

QPushButton:pressed {
    background-color: #0B1C24;
    border: 1px solid #27D07D;
}

QPushButton:disabled {
    background: #0E232B;
    color: rgba(255,255,255,0.45);
    border: 1px solid rgba(24,160,182,0.35);
}

#PbRegWrite1,
#PbRegWrite2,
#PbRegWrite3,
#PbRegWrite4 {
    min-width: 145px;
}

/*----- Focus highlight (Qt-safe) -----------------------------------------*/
*:focus {
    outline: none;
    border: 2px solid #33E1A0;
}

/*----- QProgressBar -------------------------------------------------------*/
QProgressBar {
    min-height: 20px;
    max-height: 20px;
    border: 1px solid #18A0B6;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    background-color: #081820;
    border-radius: 4px;
}

QProgressBar::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0   rgba(39, 208, 125, 255),
        stop:1   rgba(20, 140, 92, 255));
    margin: 1px;
    border-radius: 3px;
}

/*----- QGroupBox ----------------------------------------------------------*/
QGroupBox {
    border: 1px solid #18A0B6;
    border-radius: 6px;
    margin-top: 0.7em;
    padding: 8px 8px 6px 8px;
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1,
        stop:0   rgba(5, 18, 28, 220),
        stop:0.5 rgba(6, 28, 40, 235),
        stop:1   rgba(4, 12, 18, 220));
    color: #FFFFFF;
    font: 700 12pt "Segoe UI";
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 4px;
    color: #FFFFFF;
    background: transparent;
    font: 700 12pt "Segoe UI";
}

/*----- QLineEdit ----------------------------------------------------------*/
QLineEdit {
    background-color: #0B2C3A;
    border: 1px solid #18A0B6;
    border-radius: 4px;
    padding: 4px 6px;
    color: #FFFFFF;
    font-weight: 600;
    min-height: 28px;
    max-height: 28px;
}

QLineEdit:disabled {
    background-color: #0E232B;
    color: rgba(255,255,255,0.5);
    border-color: rgba(24,160,182,0.35);
}

/*----- QComboBox ----------------------------------------------------------*/
QComboBox {
    background-color: #0B2C3A;
    border: 1px solid #18A0B6;
    border-radius: 4px;
    padding-left: 6px;
    color: #E6F8F1;
    font-weight: 600;
    min-height: 30px;
}

QComboBox:hover {
    background-color: #0E3646;
    border-color: #33E1A0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    border-left: 1px solid #18A0B6;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    min-width: 22px;
    background: #0B2C3A;
}

QComboBox::down-arrow {
    image: url(:/images/icons8-arrow-down-24.png);
    width: 12px;
    height: 12px;
}

/*----- QSpinBox -----------------------------------------------------------*/
QSpinBox {
    background-color: #0B2C3A;
    border: 1px solid #18A0B6;
    border-radius: 4px;
    color: #FFFFFF;
    font-weight: 600;
    min-height: 30px;
    padding-right: 28px;
}

QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 22px;
    border-left: 1px solid #18A0B6;
    background: #0B2C3A;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 4px;
}
QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 4px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #0E3646;
    border-left-color: #33E1A0;
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
    background: #0B1C24;
}

QSpinBox::up-arrow {
    image: url(:/images/icons8-arrow-up-30.png);
    width: 12px;
    height: 11px;
}
QSpinBox::down-arrow {
    image: url(:/images/icons8-arrow-down-24.png);
    width: 12px;
    height: 11px;
}

/*----- QCheckBox ----------------------------------------------------------*/
QCheckBox {
    color: #FFFFFF;
    font-weight: 600;
    background: transparent;
    min-height: 25px;
    max-height: 25px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 24px;
    height: 24px;
}

QCheckBox::indicator:checked {
     image: url(:/images/white-checked-checkbox-50.png);
}
QCheckBox::indicator:unchecked {
    image: url(:/images/white-un-checkbox-50.png);
}

QCheckBox:disabled {
    color: rgba(255,255,255,0.5);
}

/*----- QScrollBar (vertical) ---------------------------------------------*/
QScrollBar:vertical {
    border: none;
    width: 12px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0   rgba(39, 208, 125, 255),
        stop:1   rgba(20, 140, 92, 255));
    min-height: 48px;
    border-radius: 6px;
}

/*----- QRadioButton -------------------------------------------------------*/
QRadioButton {
    color: #FFFFFF;
    background: transparent;
    min-height: 28px;
    font: 700 9pt "Segoe UI";
}

#RbPL10GSel,
#RbPL1GSel,
#RbPS1GSel,
#RbPSSerialSel,
#RbPLSerialSel {
    font-size: 11px;
    font-weight: 700;
    color: #FFFFFF;
}

QRadioButton::indicator {
    width: 24px;
    height: 24px;
}

QRadioButton::indicator:unchecked {
    image: url(:/images/white-radio-button-48.png);
}
QRadioButton::indicator:checked {
    image: url(:/images/green-checked-radio-button-48.png);
}

/*----- QTableWidget -------------------------------------------------------*/
QTableWidget {
    background: #081820;
    gridline-color: #0F3A44;
    border: 1px solid #18A0B6;
    border-radius: 4px;
}

QTableWidget::item {
    color: #FFFFFF;
    font-weight: 600;
}

QTableWidget::item:selected {
    background-color: #27D07D;
    color: #041016;
}

QHeaderView::section {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(14, 50, 60, 255),
        stop:1 rgba(8, 28, 36, 255));
    color: #E6F8F1;
    border: 1px solid #18A0B6;
    padding: 4px 6px;
    font-weight: 700;
}

/*----- QTabWidget / QTabBar ----------------------------------------------*/
QTabWidget::pane {
    border: 1px solid #18A0B6;
    top: -1px;
    background: #06141A;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
        stop:0   rgba(24, 82, 92, 255),
        stop:1   rgba(9, 45, 55, 255));
    color: #FFFFFF;
    border: 1px solid #18A0B6;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 12px;
    font-weight: 700;
    font-size: 14px;
    min-width: 86px;
    min-height: 22px;
}

QTabBar::tab:selected {
    background-color: #0B2C3A;
    border-bottom-color: #0B2C3A;
    color: #FFFFFF;
}

QTabBar::tab:hover {
    background-color: #0E3646;
    border: 1px solid #33E1A0;
}

/*----- QToolTip -----------------------------------------------------------*/
QToolTip {
    color: #041016;
    background: #27D07D;
    border: 1px solid #33E1A0;
    padding: 4px 6px;
    font: 600 10pt "Segoe UI";
}
